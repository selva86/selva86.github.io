# Copy to .dev.vars (gitignored) and fill in for local `wrangler pages dev` runs.
# In production these are set via `wrangler pages secret put <NAME> --project-name r-statistics-co`.
# NEVER commit real values. NEVER use production secrets for local dev — create dev-environment
# tokens in each provider.

# === Supabase Auth ===
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_JWT_SECRET only needed if your project uses legacy HS256 signing.
# New projects (ES256/ECC P-256) don't need it — verifier fetches JWKS instead.
SUPABASE_JWT_SECRET=
# Shared secret for the auth.users -> D1 mirror webhook. Generate ~40 random
# chars and configure Supabase Database Webhook to send it in:
# Authorization: Bearer <SUPABASE_WEBHOOK_SECRET>
SUPABASE_WEBHOOK_SECRET=replace-with-40-char-random-string

# === Paddle (Merchant of Record for non-India) ===
PADDLE_API_KEY=pdl_live_apikey_xxx
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx
# Client-side token for Paddle.js (public-safe — it ships to browsers) but kept
# env-driven so sandbox/live swap without a code change. The prefix decides the
# environment: test_ = sandbox, live_ = production; any other prefix disables
# checkout entirely (fail-loud, never guess the environment).
PADDLE_CLIENT_TOKEN=test_xxx
# Price ids surfaced via /api/_auth-config. Environment-scoped: sandbox pri_
# ids do not exist in live. Unset ids leave that CTA on the waitlist fallback.
PADDLE_TEAMS_PRICE_ID=pri_xxx
PADDLE_PRICE_SINGLE_MONTH=pri_xxx
PADDLE_PRICE_SINGLE_YEAR=pri_xxx
PADDLE_PRICE_AA_MONTH=pri_xxx
PADDLE_PRICE_AA_YEAR=pri_xxx
PADDLE_PRICE_LIFETIME=pri_xxx

# === Razorpay (Indian customers) ===
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# === Zoho Campaigns (62k newsletter list, existing) ===
# Portal: machinelearningplus (one Zoho Campaigns subscription serves both ML+ and r-statistics).
# api_domain returned by the OAuth token exchange varies by region; e.g.
#   India: https://www.zohoapis.in
#   US:    https://www.zohoapis.com
#   EU:    https://www.zohoapis.eu
ZOHO_AUTH_TOKEN=1000.xxx.xxx
ZOHO_LIST_KEY=3z1234567890abcdef
ZOHO_CAMPAIGNS_API_DOMAIN=https://www.zohoapis.in

# === Zoho ZeptoMail (transactional email — magic links, receipts, dunning) ===
# NOT the same as Zoho Campaigns. ZeptoMail is Zoho's transactional email service,
# a separate product. Get token from zeptomail.zoho.com -> Mail Agent -> SMTP/API Info.
ZOHO_ZEPTOMAIL_TOKEN=Zoho-enczapikey wSsVR60h...
ZOHO_ZEPTOMAIL_SENDER=noreply@mail.r-statistics.co

# === Sentry (error monitoring) ===
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
