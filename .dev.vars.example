# Copy to .dev.vars (gitignored) and fill in for local `wrangler pages dev` runs.
# In production these are set via `wrangler pages secret put <NAME> --project-name r-statistics-co`.
# NEVER commit real values. NEVER use production secrets for local dev — create dev-environment
# tokens in each provider.

# === Supabase Auth ===
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# === Paddle (Merchant of Record for non-India) ===
PADDLE_API_KEY=pdl_live_apikey_xxx
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx

# === Razorpay (Indian customers) ===
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# === Zoho Campaigns (62k newsletter list, existing) ===
ZOHO_AUTH_TOKEN=1000.xxx.xxx
ZOHO_LIST_KEY=3z1234567890abcdef

# === Zoho ZeptoMail (transactional email — magic links, receipts, dunning) ===
# NOT the same as Zoho Campaigns. ZeptoMail is Zoho's transactional email service,
# a separate product. Get token from zeptomail.zoho.com -> Mail Agent -> SMTP/API Info.
ZOHO_ZEPTOMAIL_TOKEN=Zoho-enczapikey wSsVR60h...
ZOHO_ZEPTOMAIL_SENDER=noreply@mail.r-statistics.co

# === Sentry (error monitoring) ===
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
