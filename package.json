{
  "name": "r-statistics-co",
  "version": "0.1.0",
  "private": true,
  "description": "r-statistics.co live application (Cloudflare Pages + Functions). Static site lives at root; backend in functions/.",
  "scripts": {
    "build": "python _build/build_with_pagefind.py",
    "dev": "wrangler pages dev . --port 8788",
    "deploy:dev": "wrangler pages deploy . --branch dev",
    "schema:dev": "wrangler d1 execute r-stats-dev --remote --file schema.sql",
    "schema:prod": "wrangler d1 execute r-stats-prod --remote --file schema.sql",
    "tail": "wrangler pages deployment tail",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260501.0",
    "pagefind": "^1.1.1",
    "typescript": "^5.4.0",
    "wrangler": "^3.99.0"
  }
}
