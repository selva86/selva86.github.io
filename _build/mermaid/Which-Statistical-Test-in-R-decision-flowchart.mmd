---
title: Which Statistical Test?
---
flowchart TD
    A["What is your\noutcome variable?"] -->|Continuous| B["How many\ngroups?"]
    A -->|Categorical| C["How many\nvariables?"]
    B -->|"2 groups"| D["Independent\nor paired?"]
    B -->|"3+ groups"| E["Independent\nor paired?"]
    D -->|Independent| F["Normal?\n(Shapiro test)"]
    D -->|Paired| G["Normal?\n(Shapiro test)"]
    F -->|Yes| H["t.test()"]
    F -->|No| I["wilcox.test()"]
    G -->|Yes| J["t.test(paired)"]
    G -->|No| K["wilcox.test(paired)"]
    E -->|Independent| L["Normal?\n(Shapiro test)"]
    E -->|Repeated| M["friedman.test()"]
    L -->|Yes| N["aov() / anova"]
    L -->|No| O["kruskal.test()"]
    C -->|"1 variable"| P["chisq.test()\ngoodness-of-fit"]
    C -->|"2 variables"| Q["chisq.test()\nor fisher.test()"]
