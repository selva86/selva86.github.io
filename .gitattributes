# Default: let git auto-detect text vs binary, normalize text to LF in repo.
# Working-copy line endings stay native (CRLF on Windows checkout, LF on Unix);
# the in-repo blob is always LF. This suppresses the per-file CRLF warnings
# git printed on every commit and keeps diffs stable across platforms.
* text=auto eol=lf

# Explicit binary marking for every binary file type in the repo. Without
# these, git might mis-detect a binary as text and apply line-ending
# conversion, corrupting it.
*.png binary
*.webp binary
*.gif binary
*.woff2 binary
*.rds binary
*.xlsx binary
