# Cloudflare Pages: files excluded from the static-asset upload so they are
# NEVER publicly served. `_redirects` 404 rules do NOT block files that exist
# as assets; `.assetsignore` does. (Verified pre-fix: pages.dev/wrangler.toml
# and /schema.sql returned 200 despite the _redirects rules.)
#
# Syntax is .gitignore-style. Do NOT add files that must serve: *.html,
# css/, www/, screenshots/, datasets/, pagefind/, sitemap.xml, feed.xml,
# robots.txt, _headers, _redirects.

# Config / infra (leak D1+KV IDs, schema, build internals)
wrangler.toml
schema.sql
package.json
package-lock.json
tsconfig.json
.dev.vars
.dev.vars.example
.gitignore
.claudecodeignore
BUILD-PHASE-0.md

# State / status trackers
post_queue.json
curriculum-status.json
pseo-status.json

# Source / build directories (fragments, markdown, scripts, plans)
functions/
_build/
_posts/
posts/
Scripts/
Plan/
Plans/
_archive/
_mocks/
post_plans/
