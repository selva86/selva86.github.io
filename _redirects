# The real mechanisms, both in functions/_middleware.ts:
#   - blocking a path  -> the BLOCK_DIRS / BLOCK_FILES / BLOCK_SOURCE_MD regexes
#   - 301 a moved page -> functions/_data/renamed-pages.json
#
# Every rule below is either already covered by the middleware denylist or
# points at a path that is not deployed. Kept only as a record of intent;
# safe to delete once someone confirms nothing external reads it.
# ############################################################################
