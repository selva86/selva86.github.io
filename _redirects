# Cloudflare Pages path-blocking rules. Source files that ship in the repo but
# must never be served publicly. Jekyll/GH Pages 404s these via underscore
# convention; CF Pages has no such convention, so we block them explicitly here.
#
# Syntax: <from-path>  <to-path>  <status>
# Status 404 means: serve /404.html with HTTP 404 status code.
#
# Tested order matters. Specific paths first, broader patterns later.
#
# ===== Index serving (needed because html_handling="none" disables auto index) =====
# Serve the homepage for "/" with a 200 rewrite (no redirect).
/                    /index.html  200

# ===== Source / build directories =====
/_posts/*            /404.html  404
/_build/*            /404.html  404
/posts/*             /404.html  404
/Scripts/*           /404.html  404
/Plan/*              /404.html  404
/Plans/*             /404.html  404
/_archive/*          /404.html  404
/_mocks/*            /404.html  404
/post_plans/*        /404.html  404
/post_queue.json     /404.html  404
/_build              /404.html  404
/_posts              /404.html  404

# ===== Function source (compiled by CF; raw TS should never serve) =====
/functions/*         /404.html  404

# ===== Config files that leak structure =====
/wrangler.toml       /404.html  404
/schema.sql          /404.html  404
/package.json        /404.html  404
/package-lock.json   /404.html  404
/tsconfig.json       /404.html  404
/.dev.vars           /404.html  404
/.dev.vars.example   /404.html  404
/.gitignore          /404.html  404
/.claudecodeignore   /404.html  404

# ===== State / status JSONs (gitignored but defensive) =====
/curriculum-status.json     /404.html  404
/pseo-status.json           /404.html  404
/exercise-hub-status.json   /404.html  404

# ===== AI / plan documents =====
/CLAUDE.md                  /404.html  404
/BUILD-PHASE-0.md           /404.html  404
/r-statistics-live-plan.md  /404.html  404
/r-statistics-live-plan.pdf /404.html  404
/README.md                  /404.html  404
/TODO.md                    /404.html  404

# ===== Backup / dev-only =====
/_backup/*           /404.html  404
/_site/*             /404.html  404
/figures/*.Rmd       /404.html  404
