# Cloudflare Pages response headers. Applied per matching path.
# Order: most specific first.

# ===== Site-wide security headers =====
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self), interest-cohort=()

# ===== API responses: never cache, no embedding =====
/api/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

# ===== Static assets: long cache =====
/css/*
  Cache-Control: public, max-age=31536000, immutable

/www/*
  Cache-Control: public, max-age=31536000, immutable

# Nav assets: short TTL so edits ship without sitewide ?v sweeps. These are
# self-contained progressive enhancements (no page-markup coupling), so a
# few minutes of version skew is harmless. Versions in pages are FROZEN
# (roadmap-nav.js?v=9, roadmap-role.js?v=15, css keys inside the JS) - do
# NOT bump them again; edit the file and deploy instead. The "! Cache-Control"
# detach is required: without it Pages MERGES this rule with /www/*'s
# immutable header instead of replacing it (observed live 2026-08-26).
/www/roadmap-nav.js
  ! Cache-Control
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/www/roadmap-nav.css
  ! Cache-Control
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/www/roadmap-role.js
  ! Cache-Control
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/screenshots/*
  Cache-Control: public, max-age=2592000

/datasets/*
  Cache-Control: public, max-age=2592000
  X-Content-Type-Options: nosniff

# ===== Pagefind index: medium cache, can change on rebuild =====
/pagefind/*
  Cache-Control: public, max-age=3600
