# Cloudflare Pages response headers. Applied per matching path.
# Order: most specific first.

# ===== Site-wide security headers =====
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self), interest-cohort=()

# ===== API responses: never cache, no embedding =====
/api/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

# ===== Static assets: long cache =====
/css/*
  Cache-Control: public, max-age=31536000, immutable

/www/*
  Cache-Control: public, max-age=31536000, immutable

/screenshots/*
  Cache-Control: public, max-age=2592000

/datasets/*
  Cache-Control: public, max-age=2592000
  X-Content-Type-Options: nosniff

# ===== Pagefind index: medium cache, can change on rebuild =====
/pagefind/*
  Cache-Control: public, max-age=3600
